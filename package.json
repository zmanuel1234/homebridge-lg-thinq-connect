{
  "name": "homebridge-lg-thinq-connect",
  "displayName": "LG ThinQ Connect",
  "version": "1.0.1",
  "description": "LG ThinQ appliances in Apple Home through LG's official ThinQ Connect API: washer and dryer time left, cycle-done and error alerts, sign-in with a personal access token.",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-lg-thinq-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-lg-thinq-connect.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-lg-thinq-connect/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "main": "dist/index.js",
  "bin": {
    "lg-thinq-diagnostics": "dist/bin/lg-thinq-diagnostics.js"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/homebridge-ui/public','dist/homebridge-ui/public',{recursive:true})\"",
    "check": "tsc -p .",
    "lint": "eslint . --max-warnings=0 && npm run check",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "verify": "npm run lint && npm run build && npm test",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify",
    "surface:update": "UPDATE_SURFACE=1 node --import tsx --test test/surface.test.ts",
    "test:homebridge1": "node -e \"require('fs').rmSync('.hb1',{recursive:true,force:true})\" && git worktree add --detach .hb1 >/dev/null && cd .hb1 && npm ci --silent && npm i --no-save --silent homebridge@1.8 && node -p \"'Homebridge ' + require('homebridge/package.json').version\" && node -e \"require('fs').symlinkSync('../hap-nodejs','node_modules/@homebridge/hap-nodejs')\" && npm run check && npm test; s=$?; cd .. && git worktree remove --force .hb1; exit $s"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "lg",
    "thinq",
    "lg-thinq",
    "thinq-connect",
    "washer",
    "dryer",
    "laundry"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  }
}
