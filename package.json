{
  "name": "homebridge-lg-thinq-connect",
  "displayName": "LG ThinQ Connect",
  "version": "3.1.2",
  "description": "LG ThinQ appliances in Apple Home through LG's official ThinQ Connect API: washers and dryers (time left, cycle-done and error alerts), air conditioners, dehumidifiers and range hoods; sign-in with a personal access token.",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-lg-thinq-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-lg-thinq-connect.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-lg-thinq-connect/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "main": "dist/index.js",
  "bin": {
    "lg-thinq-diagnostics": "dist/bin/lg-thinq-diagnostics.js"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/homebridge-ui/public','dist/homebridge-ui/public',{recursive:true})\"",
    "check": "tsc -p .",
    "lint": "oxlint",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "verify": "npm run check && npm run lint && npm run build && npm test && node .github/scripts/check-homebridge.mjs && node .github/scripts/check-config-schema.mjs",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify && node .github/scripts/check-homebridge.mjs --release",
    "surface:update": "UPDATE_SURFACE=1 node --import tsx --test test/surface.test.ts"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "lg",
    "thinq",
    "lg-thinq",
    "thinq-connect",
    "washer",
    "dryer",
    "laundry",
    "air-conditioner",
    "dehumidifier",
    "range-hood",
    "appliances",
    "smartthinq"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "homebridge": "^2.5.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
